# คัดลอกไฟล์นี้เป็น .env.local สำหรับรันในเครื่อง
# และตั้งค่าทั้งสองตัวนี้ใน Vercel > Settings > Environment Variables ก่อน deploy

# รหัสผ่านสำหรับเข้าเว็บ (fixed password ตาม docs/plan.txt)
APP_PASSWORD=changeme123

# กุญแจสำหรับเซ็น session cookie — ต้องยาวอย่างน้อย 32 ตัวอักษร และเก็บเป็นความลับ
# สร้างใหม่ได้ด้วย: openssl rand -base64 32
SESSION_SECRET=replace-this-with-a-random-string-at-least-32-chars
