# คัดลอกไฟล์นี้เป็น .env.local สำหรับรันในเครื่อง
# และตั้งค่าทั้งสองตัวใน Vercel > Settings > Environment Variables ก่อน deploy
#
# หาค่าได้ที่ Supabase Dashboard > Project Settings > API
# ทั้งสองค่าเป็น NEXT_PUBLIC ได้อย่างปลอดภัย เพราะ anon key ออกแบบมาให้เปิดเผยต่อ browser
# ห้ามเอา service_role key มาใส่เด็ดขาด เพราะ key นั้นข้าม Row Level Security ได้ทั้งหมด

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Gemini API สำหรับแชทบอทผู้ช่วย (น้องมู)
#
# *** ห้ามตั้งชื่อขึ้นต้นด้วย NEXT_PUBLIC เด็ดขาด ***
# ต่างจาก Supabase anon key ด้านบนที่ออกแบบมาให้เปิดเผยได้
# ถ้าใส่ NEXT_PUBLIC นำหน้า Next.js จะฝัง key ลง bundle ฝั่ง browser
# = แจก key ให้ทุกคนที่เปิดเว็บเอาไปใช้จนโควตาหมด
#
# ขอ key ฟรีได้ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ไม่ใส่ก็ได้ ค่าเริ่มต้นคือ gemini-3.5-flash-lite (เร็วและประหยัดโควตาที่สุด)
# หมายเหตุ: gemini-2.0-flash ถูกปลดระวางไปแล้ว ห้ามใช้
GEMINI_MODEL=
